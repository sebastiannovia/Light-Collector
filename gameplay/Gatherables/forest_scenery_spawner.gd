@tool
extends Node2D
class_name ForestScenerySpawner

const TREE_SCENE: PackedScene = preload("res://gameplay/Gatherables/harvestable_tree.tscn")
const FOLIAGE_SCRIPT := preload("res://gameplay/Gatherables/reactive_foliage.gd")
const FOREST_ATLAS_PATH := "res://Tiles/Forest Tiles/forest_atlas.png"
const GENERATED_LAYOUT_VERSION := 5
# At the default trunk and player radii, neighboring trunks leave a 60 px corridor.
const TREE_SPACING := 200.0
const EDGE_MARGIN := 32.0
const ENTRANCE_DEPTH := 420.0
const GROUND_DETAIL_PREFIXES := ["Clover_", "Plant_", "Log_"]

@export_group("Forest Trees")
@export var tree_textures: Array[Texture2D] = [
	preload("res://Assets/Trees/forest_sprucetree_01.png"),
	preload("res://Assets/Trees/forest_sprucetree_02.png"),
	preload("res://Assets/Trees/forest_sprucetree_03.png"),
	preload("res://Assets/Trees/forest_talltree_01.png"),
	preload("res://Assets/Trees/forest_tree_01.png"),
	preload("res://Assets/Trees/forest_tree_02.png"),
	preload("res://Assets/Trees/forest_tree_03.png"),
	preload("res://Assets/Trees/forest_tree_04.png"),
	preload("res://Assets/Trees/forest_tree_05.png"),
	preload("res://Assets/Trees/forest_tree_withhole_01.png"),
	preload("res://Assets/Trees/forest_tree_withhole_05.png"),
]
@export_range(0, 60, 1) var tree_count := 60
@export_range(0.25, 1.5, 0.05) var tree_scale := 1.0
@export var random_seed := 48321

@export_group("Forest Details")
@export var bush_textures: Array[Texture2D] = [
	preload("res://Assets/Bushes/forest_bush_01.png"),
	preload("res://Assets/Bushes/forest_bush_02.png"),
	preload("res://Assets/Bushes/forest_bush_03.png"),
	preload("res://Assets/Bushes/forest_bush_04.png"),
]
@export var log_textures: Array[Texture2D] = [
	preload("res://Assets/Logs/forest_treelog_01.png"),
	preload("res://Assets/Logs/forest_treelog_02.png"),
	preload("res://Assets/Logs/forest_treelogwithroots_01.png"),
]
@export var stump_textures: Array[Texture2D] = [
	preload("res://Assets/Stumps/forest_sprucetreestump_01.png"),
	preload("res://Assets/Stumps/forest_sprucetreestump_02.png"),
	preload("res://Assets/Stumps/forest_sprucetreestump_03.png"),
	preload("res://Assets/Stumps/forest_talltreestump_01.png"),
	preload("res://Assets/Stumps/forest_treestump_01.png"),
	preload("res://Assets/Stumps/forest_treestump_02.png"),
	preload("res://Assets/Stumps/forest_treestump_03.png"),
	preload("res://Assets/Stumps/forest_treestump_04and05.png"),
]
@export var plant_textures: Array[Texture2D] = [
	preload("res://Assets/Plants/forest_plant_01.png"),
	preload("res://Assets/Plants/forest_plant_02.png"),
	preload("res://Assets/Plants/forest_plant_03.png"),
]
@export var clover_textures: Array[Texture2D] = [
	preload("res://Assets/Cloverpatch/forest_cloverpatch_01.png"),
	preload("res://Assets/Cloverpatch/forest_cloverpatch_big_01.png"),
]
@export_range(0, 100, 1) var bush_count := 42
@export_range(0, 100, 1) var log_count := 8
@export_range(0, 100, 1) var stump_count := 8
@export_range(0, 100, 1) var plant_count := 75
@export_range(0, 100, 1) var clover_count := 52

var _rng := RandomNumberGenerator.new()
var _placed_positions: Array[Vector2] = []
var _container: Node2D
var _area: MapArea
var _ground: TileMapLayer
var _overlay: TileMapLayer
var _forest_cells: Array[Vector2i] = []
var _forest_cell_set: Dictionary[Vector2i, bool] = {}
var _blocked_cells: Array[Vector2i] = []
var _blocked_cell_set: Dictionary[Vector2i, bool] = {}
var _ground_to_area: Transform2D
var _area_to_ground: Transform2D
var _area_to_overlay: Transform2D
var _bounds: Rect2
var _entrances: Array[Rect2] = []
var _rebuild_queued := false


@export_tool_button("Regenerate forest scenery", "Reload")
var regenerate_action: Callable = _rebuild


func _ready() -> void:
	_area = get_parent() as MapArea
	_container = get_node_or_null("AutoGenerated") as Node2D
	if _area:
		_ground = _area.get_node_or_null("GroundArt") as TileMapLayer
		_overlay = _area.get_node_or_null("WorldArt") as TileMapLayer
		if Engine.is_editor_hint():
			_area.layout_changed.connect(_queue_layout_check)
			if _ground:
				_ground.changed.connect(_queue_layout_check)
			if _overlay:
				_overlay.changed.connect(_queue_layout_check)
	_queue_layout_check()


func _queue_layout_check() -> void:
	if _rebuild_queued:
		return
	_rebuild_queued = true
	_check_layout.call_deferred()


func _check_layout() -> void:
	_rebuild_queued = false
	if not is_inside_tree():
		return
	_update_area_geometry()
	_update_terrain()
	if not is_instance_valid(_container) or (
		_container.get_meta("layout_version", 0) != GENERATED_LAYOUT_VERSION
		or _container.get_meta("area_bounds", Rect2()) != _bounds
		or _container.get_meta("entrances", []) != _entrances
		or _container.get_meta("terrain", []) != _terrain_signature()
		or _container.get_meta("settings", []) != _settings_signature()
	):
		_rebuild()
	else:
		_order_ground_details()


func _rebuild() -> void:
	if not is_inside_tree():
		return
	_update_area_geometry()
	_update_terrain()
	if is_instance_valid(_container):
		remove_child(_container)
		_container.queue_free()
	_container = Node2D.new()
	_container.name = "AutoGenerated"
	add_child(_container)
	_set_owner(_container)
	_container.set_meta("layout_version", GENERATED_LAYOUT_VERSION)
	_container.set_meta("area_bounds", _bounds)
	_container.set_meta("entrances", _entrances.duplicate())
	_container.set_meta("terrain", _terrain_signature())
	_container.set_meta("settings", _settings_signature())
	if _forest_cells.is_empty():
		return
	_rng.seed = random_seed + str(get_parent().name).hash()
	_placed_positions.clear()

	for index in tree_count:
		var texture := _pick(tree_textures)
		if not texture:
			continue
		var tree := TREE_SCENE.instantiate() as HarvestableTree
		var scale_factor := tree_scale * _rng.randf_range(0.88, 1.04)
		var size := texture.get_size()
		var opaque := HarvestableTree.get_used_texture_rect(texture)
		var footprint := Rect2(tree.texture_offset + (Vector2(-size.x * 0.5, -size.y) + opaque.position) * scale_factor, opaque.size * scale_factor)
		footprint = _swept_footprint(footprint, tree.hit_shake_rotation_degrees).grow(tree.hit_shake_distance)
		var trunk_radius := Vector2.ONE * tree.trunk_collision_radius
		footprint = footprint.merge(Rect2(tree.trunk_collision_offset - trunk_radius, trunk_radius * 2.0))
		var point := _find_position(footprint, TREE_SPACING)
		if not point.is_finite():
			tree.free()
			continue
		tree.tree_textures = [texture]
		tree.tree_scale = scale_factor
		tree.position = _to_spawner(point)
		tree.name = "Tree_%02d" % index
		_place(tree, point)
	_place_sprite_group(bush_textures, bush_count, "Bush", 112.0, Vector2(0.7, 0.9), 75.0)
	_place_sprite_group(log_textures, log_count, "Log", 220.0, Vector2(0.75, 0.95))
	_place_sprite_group(stump_textures, stump_count, "Stump", 180.0, Vector2(0.75, 0.95))
	_place_sprite_group(plant_textures, plant_count, "Plant", 60.0, Vector2(0.8, 1.1), 55.0)
	_place_sprite_group(clover_textures, clover_count, "Clover", 60.0, Vector2(0.8, 1.1))
	_order_ground_details()


func _order_ground_details() -> void:
	# ForestScenery follows GroundArt and WorldArt at Z 0. Keep the ground
	# cover there while trees, upright props, and actors sort at Z 1 or higher.
	var children := _container.get_children()
	var next_index := 0
	for prefix in GROUND_DETAIL_PREFIXES:
		for child in children:
			var sprite := child as Sprite2D
			if not sprite or not String(sprite.name).begins_with(prefix):
				continue
			sprite.z_as_relative = false
			sprite.z_index = 0
			if sprite.get_index() != next_index:
				_container.move_child(sprite, next_index)
			next_index += 1


func _update_area_geometry() -> void:
	_bounds = Rect2(Vector2.ZERO, _area.area_size if _area else Vector2.ZERO)
	_entrances.clear()
	if not _area:
		return
	var half_width := _area.path_width * 0.5 + EDGE_MARGIN
	var span := half_width * 2.0
	var depth := minf(ENTRANCE_DEPTH, _bounds.size.y)
	for center in _area.get_pathway_centers("north"):
		_entrances.append(Rect2(center - _area.global_position.x - half_width, 0.0, span, depth))
	for center in _area.get_pathway_centers("south"):
		_entrances.append(Rect2(center - _area.global_position.x - half_width, _bounds.end.y - depth, span, depth))
	depth = minf(ENTRANCE_DEPTH, _bounds.size.x)
	for center in _area.get_pathway_centers("west"):
		_entrances.append(Rect2(0.0, center - _area.global_position.y - half_width, depth, span))
	for center in _area.get_pathway_centers("east"):
		_entrances.append(Rect2(_bounds.end.x - depth, center - _area.global_position.y - half_width, depth, span))


func _update_terrain() -> void:
	_forest_cells.clear()
	_forest_cell_set.clear()
	_blocked_cells.clear()
	_blocked_cell_set.clear()
	if not _ground or not _ground.tile_set:
		return
	_ground_to_area = _area.global_transform.affine_inverse() * _ground.global_transform
	_area_to_ground = _ground_to_area.affine_inverse()
	for cell in _ground.get_used_cells():
		if _uses_forest_atlas(_ground, cell):
			_forest_cells.append(cell)
			_forest_cell_set[cell] = true
	_forest_cells.sort()
	if _overlay and _overlay.tile_set:
		_area_to_overlay = _overlay.global_transform.affine_inverse() * _area.global_transform
		for cell in _overlay.get_used_cells():
			if not _uses_forest_atlas(_overlay, cell):
				_blocked_cells.append(cell)
				_blocked_cell_set[cell] = true
		_blocked_cells.sort()


func _settings_signature() -> Array:
	return [random_seed, tree_count, tree_scale, bush_count, log_count, stump_count, plant_count, clover_count]


func _terrain_signature() -> Array:
	return [_forest_cells.duplicate(), _blocked_cells.duplicate(), _ground_to_area, _area_to_overlay]


func _uses_forest_atlas(layer: TileMapLayer, cell: Vector2i) -> bool:
	var source := layer.tile_set.get_source(layer.get_cell_source_id(cell)) as TileSetAtlasSource
	return source != null and source.texture != null and source.texture.resource_path == FOREST_ATLAS_PATH


func _covers_forest_ground(footprint: Rect2) -> bool:
	var local_rect := _area_to_ground * footprint
	var first := _ground.local_to_map(local_rect.position)
	var last := _ground.local_to_map(local_rect.end - Vector2.ONE * 0.01)
	for y in range(first.y, last.y + 1):
		for x in range(first.x, last.x + 1):
			if not _forest_cell_set.has(Vector2i(x, y)):
				return false
	if _blocked_cell_set.is_empty():
		return true
	local_rect = _area_to_overlay * footprint
	first = _overlay.local_to_map(local_rect.position)
	last = _overlay.local_to_map(local_rect.end - Vector2.ONE * 0.01)
	for y in range(first.y, last.y + 1):
		for x in range(first.x, last.x + 1):
			if _blocked_cell_set.has(Vector2i(x, y)):
				return false
	return true


func _swept_footprint(footprint: Rect2, degrees: float) -> Rect2:
	var angle := deg_to_rad(degrees)
	var left := Transform2D(-angle, Vector2.ZERO) * footprint
	var right := Transform2D(angle, Vector2.ZERO) * footprint
	return footprint.merge(left).merge(right)


func _place_sprite_group(textures: Array[Texture2D], count: int, prefix: String, spacing: float, scale_range: Vector2, touch_radius: float = 0.0) -> void:
	for index in count:
		var texture := _pick(textures)
		if not texture:
			continue
		var sprite_scale := _rng.randf_range(scale_range.x, scale_range.y)
		var size := texture.get_size()
		var opaque := HarvestableTree.get_used_texture_rect(texture)
		var origin := Vector2(-size.x * 0.5, -opaque.end.y)
		var footprint := Rect2((origin + opaque.position) * sprite_scale, opaque.size * sprite_scale)
		if touch_radius > 0.0:
			footprint = _swept_footprint(footprint, FOLIAGE_SCRIPT.MAX_SWAY_DEGREES)
		var point := _find_position(footprint, spacing)
		if not point.is_finite():
			continue
		var sprite := Sprite2D.new()
		sprite.texture = texture
		sprite.scale = Vector2.ONE * sprite_scale
		sprite.offset = origin + size * 0.5
		if touch_radius > 0.0:
			sprite.set_script(FOLIAGE_SCRIPT)
			sprite.set("touch_radius", touch_radius)
		sprite.position = _to_spawner(point)
		sprite.name = "%s_%02d" % [prefix, index]
		_place(sprite, point)


func _find_position(footprint: Rect2, spacing: float) -> Vector2:
	if _area:
		# Convert the visible bounds to area coordinates without the spawner's translation.
		footprint = Transform2D(transform.x, transform.y, Vector2.ZERO) * footprint
	var minimum := _bounds.position + Vector2.ONE * EDGE_MARGIN - footprint.position
	var maximum := _bounds.end - Vector2.ONE * EDGE_MARGIN - footprint.end
	if minimum.x > maximum.x or minimum.y > maximum.y:
		return Vector2.INF
	var tile_size := Vector2(_ground.tile_set.tile_size)
	for attempt in 640:
		var cell := _forest_cells[_rng.randi_range(0, _forest_cells.size() - 1)]
		var jitter := Vector2(_rng.randf() - 0.5, _rng.randf() - 0.5) * tile_size
		var point := _ground_to_area * (_ground.map_to_local(cell) + jitter)
		if point.x < minimum.x or point.x > maximum.x or point.y < minimum.y or point.y > maximum.y:
			continue
		var visible_rect := Rect2(point + footprint.position, footprint.size)
		if _overlaps_entrance(visible_rect) or not _covers_forest_ground(visible_rect):
			continue
		var clear := true
		for existing in _placed_positions:
			if point.distance_squared_to(existing) < spacing * spacing:
				clear = false
				break
		if clear:
			return point
	return Vector2.INF


func _overlaps_entrance(visible_rect: Rect2) -> bool:
	for entrance in _entrances:
		if entrance.intersects(visible_rect):
			return true
	return false


func _to_spawner(point: Vector2) -> Vector2:
	return transform.affine_inverse() * point if _area else point


func _place(node: Node2D, point: Vector2) -> void:
	node.z_as_relative = false
	node.z_index = clampi(roundi(point.y / 8.0), 1, 256)
	_container.add_child(node)
	_set_owner(node)
	_placed_positions.append(point)


func _pick(textures: Array[Texture2D]) -> Texture2D:
	if textures.is_empty():
		return null
	return textures[_rng.randi_range(0, textures.size() - 1)]


func _set_owner(node: Node) -> void:
	if Engine.is_editor_hint() and get_tree().edited_scene_root:
		node.owner = get_tree().edited_scene_root
